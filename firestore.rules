rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // createdAt/updatedAt are set via serverTimestamp() (see
    // src/lib/firestore/writes.ts) — this rejects any write that doesn't
    // set both to the server's own authoritative time, so a client can't
    // spoof an earlier/later timestamp. Only checked on create — paychecks/
    // purchases/plaidTransactions still have no update path that changes
    // createdAt, so their update rules don't call this. categories/
    // incomeSources now do have a real update path (setCategoryBuckets/
    // setIncomeSourceBuckets, src/lib/firestore/writes.ts) — see those
    // match blocks below for the corresponding
    // `updatedAt == request.time` check on update.
    function hasValidTimestamps() {
      return request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    // Both null (never set) and an empty list are valid "no auto-
    // categorize mapping" states — only reject a non-list value.
    function hasValidAutoCategorizeBuckets() {
      return !('autoCategorizeBuckets' in request.resource.data)
        || request.resource.data.autoCategorizeBuckets is list;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId)
        && (!('bankBalance' in request.resource.data) || request.resource.data.bankBalance is number)
        && (!('paychecksPerMonth' in request.resource.data) || request.resource.data.paychecksPerMonth is number);
      allow delete: if false;

      match /categories/{categoryId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.name is string
          && request.resource.data.iconName is string
          && request.resource.data.color is string
          && request.resource.data.resetDay is number
          && request.resource.data.type in ['fixed', 'percentage']
          && hasValidAutoCategorizeBuckets()
          && hasValidTimestamps();
        // The only update path today is setCategoryBuckets (src/lib/
        // firestore/writes.ts#updateCategoryBuckets) — a partial write
        // touching only autoCategorizeBuckets/updatedAt. Firestore's
        // update() merges into the existing doc, so the other fields below
        // still resolve to their unchanged values — this just re-validates
        // they're still well-typed, same checks as create.
        allow update: if isOwner(userId)
          && request.resource.data.name is string
          && request.resource.data.iconName is string
          && request.resource.data.color is string
          && request.resource.data.resetDay is number
          && request.resource.data.type in ['fixed', 'percentage']
          && hasValidAutoCategorizeBuckets()
          && request.resource.data.updatedAt == request.time;
      }

      match /incomeSources/{sourceId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.name is string
          && request.resource.data.iconName is string
          && request.resource.data.color is string
          && request.resource.data.incomeType in ['w2', 'contracted', 'selfEmployed']
          && hasValidAutoCategorizeBuckets()
          && hasValidTimestamps();
        allow update: if isOwner(userId)
          && request.resource.data.name is string
          && request.resource.data.iconName is string
          && request.resource.data.color is string
          && request.resource.data.incomeType in ['w2', 'contracted', 'selfEmployed']
          && hasValidAutoCategorizeBuckets()
          && request.resource.data.updatedAt == request.time;
      }

      match /paychecks/{paycheckId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.amount is number && request.resource.data.amount > 0
          && request.resource.data.date is string
          && request.resource.data.sourceId is string
          && hasValidTimestamps();
        allow update: if isOwner(userId)
          && request.resource.data.amount is number && request.resource.data.amount > 0
          && request.resource.data.date is string
          && request.resource.data.sourceId is string;
      }

      match /purchases/{purchaseId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.amount is number && request.resource.data.amount > 0
          && request.resource.data.date is string
          && request.resource.data.categoryId is string
          && request.resource.data.description is string
          && hasValidTimestamps();
        allow update: if isOwner(userId)
          && request.resource.data.amount is number && request.resource.data.amount > 0
          && request.resource.data.date is string
          && request.resource.data.categoryId is string
          && request.resource.data.description is string;
      }

      // Raw bank transactions synced from Plaid (not yet wired to a real
      // Plaid connection — see functions/src/index.ts). Created by the
      // "Simulate bank sync" demo action today; in real usage would be
      // created by a Cloud Function via the Admin SDK, which bypasses these
      // rules entirely, so `create` here only really governs client-side
      // writes (the demo seed).
      match /plaidTransactions/{transactionId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.accountName is string
          && request.resource.data.amount is number && request.resource.data.amount > 0
          && request.resource.data.date is string
          && request.resource.data.merchantName is string
          && request.resource.data.plaidCategory is string
          && request.resource.data.transactionType in ['spending', 'income', 'transfer']
          && request.resource.data.pending is bool
          && hasValidTimestamps();
        // The only update path today is categorization (see
        // categorizePlaidTransactionAsSpending/AsIncome in
        // src/lib/firestore/writes.ts) — assigns categoryId+purchaseId
        // (spending) or sourceId+paycheckId (income) and bumps updatedAt.
        // The fields synced from Plaid itself are immutable once created.
        allow update: if isOwner(userId)
          && request.resource.data.accountName == resource.data.accountName
          && request.resource.data.amount == resource.data.amount
          && request.resource.data.date == resource.data.date
          && request.resource.data.merchantName == resource.data.merchantName
          && request.resource.data.plaidCategory == resource.data.plaidCategory
          && request.resource.data.transactionType == resource.data.transactionType
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;
      }

      // Precomputed per-period totals — see src/lib/firestore/
      // recomputeSnapshot.ts (client writes) and plaid-server's own copy of
      // that logic (Plaid-driven writes). Client can read (drives every
      // headline total/history lookup) and write (manual purchase/paycheck
      // edits recompute these directly, not via a Cloud Function), but only
      // ever as a full, type-checked overwrite of its own numbers — no
      // delete, since a snapshot is never removed, only recomputed.
      match /monthlySnapshots/{periodId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.totalSpent is number
          && request.resource.data.totalIncome is number
          && (!('bankBalance' in request.resource.data) || request.resource.data.bankBalance is number)
          && request.resource.data.updatedAt == request.time;
      }

      match /yearlySnapshots/{periodId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.totalSpent is number
          && request.resource.data.totalIncome is number
          && (!('bankBalance' in request.resource.data) || request.resource.data.bankBalance is number)
          && request.resource.data.updatedAt == request.time;
      }

      // Plaid item credentials (access_token + sync cursor per linked bank
      // account) — see plaid-server/src/routes/exchangeToken.ts and
      // syncTransactions.ts. Deliberately DENY the client entirely, both
      // read and write: access_token grants ongoing read access to the
      // user's real bank account, so it must never be readable from the
      // browser, only by plaid-server's Admin SDK (which bypasses these
      // rules — this match block exists purely to guarantee no client path
      // can ever reach this collection).
      match /plaidItems/{itemId} {
        allow read, write: if false;
      }
    }
  }
}

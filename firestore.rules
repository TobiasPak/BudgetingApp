rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // createdAt/updatedAt are set via serverTimestamp() (see
    // src/lib/firestore/writes.ts) — this rejects any write that doesn't
    // set both to the server's own authoritative time, so a client can't
    // spoof an earlier/later timestamp. Only checked on create: there's no
    // update path for any of these 4 collections yet (every write is a
    // brand-new document), so an update rule requiring this doesn't have
    // a real use case to validate against yet. When an edit feature is
    // eventually built, the update rule should require
    // `updatedAt == request.time` and `createdAt == resource.data.createdAt`
    // (unchanged) instead of this same check.
    function hasValidTimestamps() {
      return request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId)
        && (!('bankBalance' in request.resource.data) || request.resource.data.bankBalance is number)
        && (!('paychecksPerMonth' in request.resource.data) || request.resource.data.paychecksPerMonth is number);
      allow delete: if false;

      match /categories/{categoryId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.name is string
          && request.resource.data.iconName is string
          && request.resource.data.color is string
          && request.resource.data.resetDay is number
          && request.resource.data.type in ['fixed', 'percentage']
          && hasValidTimestamps();
        allow update: if isOwner(userId)
          && request.resource.data.name is string
          && request.resource.data.iconName is string
          && request.resource.data.color is string
          && request.resource.data.resetDay is number
          && request.resource.data.type in ['fixed', 'percentage'];
      }

      match /incomeSources/{sourceId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.name is string
          && request.resource.data.iconName is string
          && request.resource.data.color is string
          && request.resource.data.incomeType in ['w2', 'contracted', 'selfEmployed']
          && hasValidTimestamps();
        allow update: if isOwner(userId)
          && request.resource.data.name is string
          && request.resource.data.iconName is string
          && request.resource.data.color is string
          && request.resource.data.incomeType in ['w2', 'contracted', 'selfEmployed'];
      }

      match /paychecks/{paycheckId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.amount is number && request.resource.data.amount > 0
          && request.resource.data.date is string
          && request.resource.data.sourceId is string
          && hasValidTimestamps();
        allow update: if isOwner(userId)
          && request.resource.data.amount is number && request.resource.data.amount > 0
          && request.resource.data.date is string
          && request.resource.data.sourceId is string;
      }

      match /purchases/{purchaseId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.amount is number && request.resource.data.amount > 0
          && request.resource.data.date is string
          && request.resource.data.categoryId is string
          && request.resource.data.description is string
          && hasValidTimestamps();
        allow update: if isOwner(userId)
          && request.resource.data.amount is number && request.resource.data.amount > 0
          && request.resource.data.date is string
          && request.resource.data.categoryId is string
          && request.resource.data.description is string;
      }

      // Raw bank transactions synced from Plaid (not yet wired to a real
      // Plaid connection — see functions/src/index.ts). Created by the
      // "Simulate bank sync" demo action today; in real usage would be
      // created by a Cloud Function via the Admin SDK, which bypasses these
      // rules entirely, so `create` here only really governs client-side
      // writes (the demo seed).
      match /plaidTransactions/{transactionId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.accountName is string
          && request.resource.data.amount is number && request.resource.data.amount > 0
          && request.resource.data.date is string
          && request.resource.data.merchantName is string
          && request.resource.data.plaidCategory is string
          && request.resource.data.transactionType in ['spending', 'income', 'transfer']
          && request.resource.data.pending is bool
          && hasValidTimestamps();
        // The only update path today is categorization (see
        // categorizePlaidTransactionAsSpending/AsIncome in
        // src/lib/firestore/writes.ts) — assigns categoryId+purchaseId
        // (spending) or sourceId+paycheckId (income) and bumps updatedAt.
        // The fields synced from Plaid itself are immutable once created.
        allow update: if isOwner(userId)
          && request.resource.data.accountName == resource.data.accountName
          && request.resource.data.amount == resource.data.amount
          && request.resource.data.date == resource.data.date
          && request.resource.data.merchantName == resource.data.merchantName
          && request.resource.data.plaidCategory == resource.data.plaidCategory
          && request.resource.data.transactionType == resource.data.transactionType
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;
      }
    }
  }
}

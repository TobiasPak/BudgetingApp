# Dependencies
node_modules/
functions/node_modules/

# Build output
dist/
dist-ssr/
functions/lib/
*.local

# Env files
.env
.env.local
.env.*.local
.env.staging
.env.production

# plaid-server (node_modules/, dist/, and .env are already covered by the
# bare patterns above, since they match at any depth). Firebase service
# account keys specifically — never commit these regardless of filename.
plaid-server/service-account-key.json
plaid-server/*firebase-adminsdk*.json

# Firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
*-debug.log

# Editor
.vscode/*
!.vscode/extensions.json
.idea

# OS
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
CLAUDE.md

# Copy this file to .env and fill in real values. This server is a plain
# Node process (not a Firebase Cloud Function), so it just reads a normal
# dotenv file — no Secret Manager, no Blaze plan required.

# From your Plaid dashboard (https://dashboard.plaid.com/team/keys).
# Use your SANDBOX client id/secret for local dev.
PLAID_CLIENT_ID=
PLAID_SECRET=
# 'sandbox' | 'production'
PLAID_ENV=sandbox

# Set to "true" for local dev against the Firebase emulators (matches the
# root app's VITE_USE_FIREBASE_EMULATORS) — no real credentials needed at
# all in this mode, GOOGLE_APPLICATION_CREDENTIALS below is ignored.
USE_FIREBASE_EMULATORS=true

# Only needed when USE_FIREBASE_EMULATORS is not "true". Path to a Firebase
# service account key JSON file, used so this server can verify signed-in
# users' ID tokens and write to Firestore with the Admin SDK (which
# bypasses firestore.rules — this server is trusted the same way a Cloud
# Function would be). Generate one yourself: Firebase Console -> Project
# Settings -> Service Accounts -> Generate new private key. Save it outside
# version control (e.g. plaid-server/service-account-key.json, already
# gitignored) and point this at it.
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json

# The Firebase project this server's Firestore writes should target. Use
# the same project id your frontend is currently pointed at (see the root
# .env.local / .env.staging / .env.production's VITE_FIREBASE_PROJECT_ID).
FIREBASE_PROJECT_ID=

# Local server port and the frontend origin allowed to call it (CORS).
PORT=8090
CORS_ORIGIN=http://localhost:5173

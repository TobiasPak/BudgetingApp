# This app has 3 environments, each with its own gitignored env file, all
# with this same shape (Firebase config values + the emulator flag):
#   .env.local       — default for plain `npm run dev`. Emulator-first.
#   .env.staging     — `npm run dev:staging`. Real project budgetapp-67761
#                      (Console-labeled "budgetapp-staging" — project IDs
#                      can't actually be renamed).
#   .env.production  — `npm run dev:prod`. Real project budgetapp-prod-f0c9a,
#                      a genuinely separate Firebase project (its own
#                      Firestore/Auth, not just a 2nd web app registration).
# Copy this file to whichever of the three you're setting up and fill in
# real values from Firebase Console → (that project) → Project Settings →
# General → Your apps.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to connect to local Auth/Firestore emulators
# (firebase emulators:start --only auth,firestore) instead of a real
# project. Only .env.local should ever be "true" — staging/production are
# real Firebase projects, not the emulator.
VITE_USE_FIREBASE_EMULATORS=

# Optional. App Check reCAPTCHA v3 site key (from
# https://www.google.com/recaptcha/admin, or auto-created via Firebase
# Console → App Check → your app → reCAPTCHA v3). Leave unset in
# .env.local — the emulators don't check App Check, so there's nothing to
# protect there. Set in .env.staging/.env.production once you've
# registered the app in each project's App Check settings.
VITE_FIREBASE_RECAPTCHA_SITE_KEY=

# Plaid, Veryfi, and Resend/SendGrid API keys are NOT client env vars.
# They are server-side secrets set on Cloud Functions via:
#   firebase functions:secrets:set <SECRET_NAME>

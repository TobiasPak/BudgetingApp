# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and read by Vite via import.meta.env.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to connect to local Auth/Firestore emulators
# (firebase emulators:start --only auth,firestore) instead of the real
# project. Leave unset/false to hit the real budgetapp-67761 project.
VITE_USE_FIREBASE_EMULATORS=

# Plaid, Veryfi, and Resend/SendGrid API keys are NOT client env vars.
# They are server-side secrets set on Cloud Functions via:
#   firebase functions:secrets:set <SECRET_NAME>
